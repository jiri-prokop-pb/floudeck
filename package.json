{
  "name": "floudeck",
  "version": "0.2.1",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch run src/server.ts",
    "build:server": "bun run scripts/build.ts",
    "build": "bun run scripts/build.ts && cd src-tauri && cargo tauri build",
    "dev:tauri": "cd src-tauri && cargo tauri dev",
    "test": "bun test src/",
    "lint": "bun biome check .",
    "format": "bun biome check --fix .",
    "check": "bun biome check . && bun run test && bun run e2e",
    "e2e": "bun run scripts/run-e2e.ts",
    "bump": "bun run scripts/bump-version.ts",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@napi-rs/canvas": "0.1.97",
    "@playwright/test": "1.58.2",
    "@types/bun": "1.3.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-plugin-tailwind": "0.1.2",
    "lefthook": "2.1.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/typography": "0.5.19",
    "marked": "17.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.2.1",
    "zod": "4.3.6"
  }
}
