{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/v2/crates/tauri-cli/schema.json",
  "productName": "Floudeck",
  "version": "0.1.0",
  "identifier": "com.floudeck.app",
  "build": {
    "beforeBuildCommand": "bun run build:server",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "Floudeck",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "url": "about:blank"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "externalBin": ["binaries/floudeck-server"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": {
        "sidecar": true
      }
    }
  }
}
